# Database
DATABASE_URL=postgresql+asyncpg://roadsos:roadsos@localhost:5432/roadsos
DATABASE_URL_SYNC=postgresql://roadsos:roadsos@localhost:5432/roadsos

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Twilio (optional - for SMS/voice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_SMS_NUMBER=

# WhatsApp Business API (optional)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# LLM (optional - mock triage used by default)
USE_MOCK_LLM=true
USE_MOCK_DISPATCH=true
LLM_MODEL_PATH=meta-llama/Llama-3.1-8B-Instruct

# Maps
OPENCAGE_API_KEY=
MAPBOX_TOKEN=

# Security
JWT_SECRET=change-me-in-production
